{
  "name": "@dynamicsninja/technogym-mcp",
  "version": "0.1.1",
  "description": "MCP server for Technogym mywellness: read your gym workouts, sets and treadmill/bike analytics from Claude. Built on technogym-js.",
  "keywords": [
    "technogym",
    "mywellness",
    "mcp",
    "model-context-protocol",
    "claude",
    "workouts"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DynamicsNinja/technogym-js.git",
    "directory": "mcp"
  },
  "author": "ificko",
  "license": "MIT",
  "type": "module",
  "bin": {
    "technogym-mcp": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run build && npm test",
    "prepublishOnly": "npm run check",
    "prepack": "node -e \"for (const f of ['LICENSE','NOTICE']) require('fs').copyFileSync('../'+f, f)\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2"
  }
}
